!!- 65536 B of heap space and 32 B minimum per block -> 2048 possible blocks
!!- so we need 2048 bits (256 B or 32 words) in total for an entire bitmap
!!- we have 12 layers of blocks (sizes 2^5 to 2^16 B) -> 12 pointers to free lists

let int HEAP_SIZE = 65536

let int MIN_SIZE = 32
let int NUM_ORDERS = 12
let int NULL = -1

record metadata (
        mut int[12] free_head,
        mut char[2048] order_of,
        mut int[32] is_free         !!- 2048 / 64
)

let &mut metadata metadata_ptr = unsafe &metadata(asm("ldr x10, =__heapmeta"))
let int heap_ptr = unsafe int(asm("ldr x10, =__heap"))

record free_node (
        mut int next,
        mut int prev
)

&free_node node_at(int index){
        let int ptr = heap_ptr + index * MIN_SIZE;
        hop unsafe &free_node(ptr);
}

bool bit_test(int index){
        !!- word size is 64 = 2^6 bits
        let int result = (metadata_ptr..is_free[index >> 6] >> (index & 63)) & 1;
        hop unsafe bool(result);
}

void bit_set(int index){
        let int word_index = index >> 6;
        metadata_ptr..is_free[word_index] |= (1 << (index & 63));
}

void bit_clear(int index){
        let int word_index = index >> 6;
        metadata_ptr..is_free[word_index] &= ~(1 << (index & 63));
}

void order_set(int index, int order){
        metadata_ptr..order_of[index] = safe char(order);
}

int order_get(int index){
        hop safe int(metadata_ptr..order_of[index]);
}

void list_push(int order, int index){
        let &mut free_node n = node_at(index);

        n..prev = NULL;
        n..next = metadata_ptr..free_head[order];

        if (n..next != NULL){
                let &free_node next = node_at(n..next);
                next..prev = index;
        }

        metadata_ptr..free_head[order] = index;
        order_set(index, order);
        bit_set(index);
}

void list_remove(int order, int index){
        let &free_node n = node_at(index);

        if (n..prev != NULL){
                let &free_node prev = node_at(n..prev);
                prev..next = n..next;
        }
        else {
                metadata_ptr..free_head[order] = n..next;
        }

        if (n..next != NULL){
                let &free_node next = node_at(n..next);
                next..prev = n..prev;
        }

        bit_clear(index);
}

void meminit(){
        !!- set all memory for metadata to 0 initially
        for (let mut int i = 0; i < 12 + 256 + 32; ++i){
                let &mut int ptr = unsafe &int(unsafe int(metadata_ptr) + 8 * i);
                *ptr = 0;
        }

        for (let mut int o = 0; o < NUM_ORDERS; ++o){
                metadata_ptr..free_head[o] = NULL;
        }

        list_push(NUM_ORDERS - 1, 0);
}

int order_for_size(int size){
        if (size == 0 || size > HEAP_SIZE){
                hop -1;
        }

        let mut int order = 0;
        let mut int block = MIN_SIZE;
        while (block < size){
                block <<= 1;
                ++order;
        }

        if (order > NUM_ORDERS - 1){
                hop -1;
        }

        hop order;
}

&int memalloc(int size){
        let int order = order_for_size(size);
        if (order < 0){
                hop unsafe &int(0);
        }

        let mut int o = order;
        while (o <= NUM_ORDERS - 1 && metadata_ptr..free_head[o] == NULL){
                ++o;
        }

        if (o > NUM_ORDERS - 1){
                hop unsafe &int(0);
        }

        let int index = metadata_ptr..free_head[o];
        list_remove(o, index);

        while (o > order){
                --o;
                let int buddy = index + (1 << o);
                list_push(o, buddy);
        }

        order_set(index, order);
        bit_clear(index);

        let int ptr = heap_ptr + index * MIN_SIZE;
        hop unsafe &int(ptr);
}

void memfree(&int ptr){
        if (unsafe int(ptr) == 0){
                hop;
        }

        let mut int index = (unsafe int(ptr) - heap_ptr) / MIN_SIZE;
        let mut int order = order_get(index);

        let mut bool done = false;
        while (!done && order < NUM_ORDERS - 1){
                let int buddy = index ^ (1 << order);

                if (!bit_test(buddy) || (order_get(buddy) != order)){
                        done = true;
                }
                else {
                        list_remove(order, buddy);
                        if (buddy < index){
                                index = buddy;
                        }
                        ++order;
                }
        }

        list_push(order, index);
}

bool memcheck(){
        hop metadata_ptr..free_head[NUM_ORDERS - 1] == 0;
}
