!!munch poppymem

int strlen(string s){
        hop s.length;
}

bool streq(string s1, string s2){
        if (s1.length != s2.length){
                hop false;
        }

        let mut &char ptr1 = s1.ptr;
        let mut &char ptr2 = s2.ptr;

        for (let mut int i = 0; i < s1.length; ++i){
                let char c1 = *ptr1;
                let char c2 = *ptr2;
                if (c1 != c2){
                        hop false;
                }

                ptr1 = unsafe &char(unsafe int(ptr1) + 1);
                ptr2 = unsafe &char(unsafe int(ptr2) + 1);
        }

        hop true;
}

char strat(string s, int i){
        hop *(unsafe &char(unsafe int((s.ptr)) + i));
}

string strconcat(string s1, string s2){
        let int total_length = strlen(s1) + strlen(s2);
        let int bytes = (total_length + 7) / 8;

        let string new_str;
        new_str.length = total_length;
        new_str.ptr = safe &char(memalloc(bytes));

        let mut &mut char new_ptr = new_str.ptr;
        let mut &char s1_ptr = s1.ptr;
        let mut &char s2_ptr = s2.ptr;

        for (let mut int i = 0; i < s1.length; ++i){
                *new_ptr = *s1_ptr;
                new_ptr = unsafe &char(unsafe int(new_ptr) + 1);
                s1_ptr = unsafe &char(unsafe int(s1_ptr) + 1);
        }

        for (let mut int i = 0; i < s2.length; ++i){
                *new_ptr = *s2_ptr;
                new_ptr = unsafe &char(unsafe int(new_ptr) + 1);
                s2_ptr = unsafe &char(unsafe int(s2_ptr) + 1);
        }

        hop new_str;
}

void strfree(string s){
        memfree(safe &int(s.ptr));
}
