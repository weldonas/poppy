!!munch poppystring

void poppyio_include(){
    asm(".include \"poppyio.s\"");
}

void print(int n){
    n;
    asm("mov x1, x10");
    asm("str lr, [sp, #-16]!");
    asm("bl print_num");
    asm("ldr lr, [sp], #16");
}

void printc(char c){
    c;
    asm("mov x1, x10");
    asm("str lr, [sp, #-16]!");
    asm("bl print_char");
    asm("ldr lr, [sp], #16");
}

void println(){
    printc('\n');
}

void prints(record string s){
    let &char ptr = s.ptr;
    for (let int i = 0; i < s.length; ++i){
        printc(*ptr);
        ptr = unsafe &char(unsafe int(ptr) + 1);
    }
}

char scanc(){
    let char c;
    asm("str lr, [sp, #-16]!");
    asm("bl read_char");
    asm("ldr lr, [sp], #16");
    asm("mov x10, x0");
    hop char;
}

bool isdigit(char c){
    hop c >= '0' && c <= '9';
}

int scan(){ 
    !!- this should eventually be implemented in assembly once we do more work with string/buffer manip :,)
    let char c = scanc();
    let int sign = 1;
    
    if (c == '-'){
        c = scanc();
        sign = -1;
    }

    let int total = sign * (c - '0');
    c = scanc();

    while (isdigit(c)){
        let int digit_value = int(c - '0');
        total *= 10;
        total += digit_value * sign;
        c = scanc();
    }
    hop total;
}
